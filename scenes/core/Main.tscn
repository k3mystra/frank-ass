[node name="Room1Hint" type="Label3D" parent="." unique_id=1517315074]
transform = Transform3D(-1.9071367e-08, 0, -0.436302, 0, 0.436302, 0, 0.436302, 0, -1.9071367e-08, 3.9664366, 1.8618327, -9.90116)
modulate = Color(0.37254903, 0.5019608, 0.3254902, 1)
outline_modulate = Color(0.3721325, 0.5035897, 0.32540035, 1)
text = "My fourth is the heartbeat before heaven’s spark,
When flesh remains silent and cold in the dark.
No pulse, no waking, no life yet begun,
Until lightning decides what my hands could not done."
font = ExtResource("18_ship8")
font_size = 64
outline_size = 0
horizontal_alignment = 0

[node name="Room1Hint4" type="Label3D" parent="." unique_id=2048046082]
transform = Transform3D(-1.9071367e-08, 0, -0.436302, 0, 0.436302, 0, 0.436302, 0, -1.9071367e-08, 3.9664366, 2.6919153, -9.860908)
modulate = Color(0.37254903, 0.5019608, 0.3254902, 1)
outline_modulate = Color(0.3721325, 0.5035897, 0.32540035, 1)
text = "My third are the pillars that keep him from death,
The blood in his body, the thought, and the breath.
Three fragile duties, three burdens to bear,
Leave even one failing, and nothing stays there."
font = ExtResource("18_ship8")
font_size = 64
outline_size = 0
horizontal_alignment = 0

[node name="Room1Hint3" type="Label3D" parent="." unique_id=563977535]
transform = Transform3D(-1.9071367e-08, 0, -0.436302, 0, 0.436302, 0, 0.436302, 0, -1.9071367e-08, 3.9671154, 1.8585045, -12.742271)
modulate = Color(0.37254903, 0.5019608, 0.3254902, 1)
outline_modulate = Color(0.3721325, 0.5035897, 0.32540035, 1)
text = "My second lies sleeping in CREATURE’s name,
Count every letter and answer the same.
Not blood, not bone, nor spark from above,
But the word I gave what I dared call love."
font = ExtResource("18_ship8")
font_size = 64
outline_size = 0
horizontal_alignment = 0

[node name="Room1Hint2" type="Label3D" parent="." unique_id=82726950]
transform = Transform3D(-1.9071367e-08, 0, -0.436302, 0, 0.436302, 0, 0.436302, 0, -1.9071367e-08, 3.9671154, 2.6958215, -12.719832)
modulate = Color(0.37254903, 0.5019608, 0.3254902, 1)
outline_modulate = Color(0.3721325, 0.5035897, 0.32540035, 1)
text = "My first walked no halls before my hand,
No stitched-up soul yet haunted the land.
No groan in the rafters, no step in the night,
No creature of mine had yet risen to sight.
"
font = ExtResource("18_ship8")
font_size = 64
outline_size = 0
horizontal_alignment = 0

